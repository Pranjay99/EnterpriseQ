# ── LLM (answer generation) ──────────────────────────────────────────
# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_api_key_here

# ── Embeddings (local, no API key needed) ────────────────────────────
# Optional override of the local sentence-transformers model.
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Authentication (Supabase) ─────────────────────────────────────────
# Leave both empty to run WITHOUT login (local development only).
# Option A (legacy secret): Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=
# Option B (new projects with asymmetric signing keys): just the project URL,
# e.g. https://abcdefgh.supabase.co — the backend verifies tokens via JWKS.
SUPABASE_URL=

# ── Fine-tuned Text-to-SQL model (optional — see finetuning/README.md) ─
# Any OpenAI-compatible endpoint (Ollama, llama.cpp server, Together, ...).
# Leave empty to use Gemini for SQL generation.
SQL_LLM_ENDPOINT=
SQL_LLM_MODEL=enterprise-q-sql-lora
SQL_LLM_API_KEY=

# ── Server settings ───────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (CORS)
ALLOWED_ORIGINS=http://localhost:3000
# Maximum upload size in MB
MAX_UPLOAD_MB=20
